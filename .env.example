# Required: generate using php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Required: generate using php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
APP_SETUP_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_16_CHARACTERS

# Create a MySQL database and dedicated user in cPanel; grant all permissions on that database.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CPANELUSER_zohal
DB_USER=CPANELUSER_zohal
DB_PASSWORD="REPLACE_WITH_YOUR_DATABASE_PASSWORD"

# Confirm upstream settings against Zohal's official integration contract.
ZOHAL_API_BASE_URL=https://api.zohal.io
ZOHAL_AUTH_HEADER=Authorization
ZOHAL_AUTH_PREFIX="Bearer "
