# Generate APP_KEY: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Generate APP_SETUP_KEY: php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
APP_SETUP_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_16_CHARACTERS
# Must match the official API origin documented by Zohal. Never include untrusted hosts.
ZOHAL_API_BASE_URL=https://api.zohal.io
# Verify exact authentication header and prefix with the official Zohal docs.
ZOHAL_AUTH_HEADER=Authorization
ZOHAL_AUTH_PREFIX="Bearer "
